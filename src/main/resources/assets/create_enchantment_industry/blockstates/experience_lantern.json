{
  "multipart": [
    {
      "when": {"facing": "up"},
      "apply": {
        "model": "create_enchantment_industry:block/experience_lantern"
      }
    },
    {
      "when": {"facing": "down"},
      "apply": {
        "model": "create_enchantment_industry:block/experience_lantern",
        "x": 180
      }
    },
    {
      "when": {"facing": "north"},
      "apply": {
        "model": "create_enchantment_industry:block/experience_lantern",
        "x": 90
      }
    },
    {
      "when": {"facing": "south"},
      "apply": {
        "model": "create_enchantment_industry:block/experience_lantern",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {"facing": "east"},
      "apply": {
        "model": "create_enchantment_industry:block/experience_lantern",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {"facing": "west"},
      "apply": {
        "model": "create_enchantment_industry:block/experience_lantern",
        "x": 90,
        "y": 270
      }
    }
  ]
}
